# Copy to .env and fill in. All vars are optional except where noted.

# --- server ---
SCRAPER_HOST=127.0.0.1
SCRAPER_PORT=8000
# REQUIRED for any networked deployment. Generate: openssl rand -hex 32
SCRAPER_AUTH_TOKEN=
# http (default) or stdio
SCRAPER_TRANSPORT=http

# --- resource caps ---
SCRAPER_MAX_CONCURRENT_PAGES=8
SCRAPER_MAX_CRAWL_PAGES=100
SCRAPER_PER_DOMAIN_DELAY_S=1.0

# --- politeness / SSRF ---
SCRAPER_RESPECT_ROBOTS=true
# Keep false on any networked deployment (SSRF protection).
SCRAPER_ALLOW_PRIVATE_NETWORKS=false

# --- LLM (extract / deep_research) ---
ANTHROPIC_API_KEY=

# --- search backends (first set wins; else DuckDuckGo) ---
SCRAPER_SEARXNG_URL=
BRAVE_API_KEY=
TAVILY_API_KEY=
