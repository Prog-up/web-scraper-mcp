# Copy to .env; keep secrets out of Git.
SCRAPER_HOST=127.0.0.1
SCRAPER_PORT=8000
SCRAPER_TRANSPORT=http
# Required for HTTP. Generate with openssl rand -hex 32.
SCRAPER_AUTH_TOKEN=

SCRAPER_MAX_REQUEST_BYTES=256000
SCRAPER_MAX_RESPONSE_BYTES=5000000
SCRAPER_REQUEST_TIMEOUT_S=30
SCRAPER_TOOL_TIMEOUT_S=180
SCRAPER_MAX_CONCURRENT_TOOLS=8
SCRAPER_MAX_CONCURRENT_FETCHES=8
SCRAPER_MAX_CONCURRENT_PAGES=4
SCRAPER_MAX_CONCURRENT_LLM=2
SCRAPER_MAX_CONCURRENT_CRAWLS=2
SCRAPER_CRAWL_CONCURRENCY=3
SCRAPER_MAX_CRAWL_JOBS=16
SCRAPER_MAX_CRAWL_PAGES=100
SCRAPER_MAX_CRAWL_DEPTH=3
SCRAPER_CRAWL_TIMEOUT_S=180
SCRAPER_CRAWL_TTL_S=600
SCRAPER_CRAWL_RESULT_BYTES=5000000
SCRAPER_CRAWL_FRONTIER_LIMIT=1000
SCRAPER_MAX_BROWSER_SESSIONS=2
SCRAPER_BROWSER_SESSION_TTL_S=300
SCRAPER_BROWSER_SNAPSHOT_BYTES=64000
SCRAPER_BROWSER_STEALTH=true
SCRAPER_PER_DOMAIN_DELAY_S=1
SCRAPER_MAX_REDIRECTS=5
SCRAPER_CACHE_ENTRIES=512
SCRAPER_CACHE_TTL_S=300
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_ALLOW_PRIVATE_NETWORKS=false

# Rendering needs Chromium, an isolated network and the guarded proxy.
SCRAPER_BROWSER_ENABLED=false
# SCRAPER_EGRESS_PROXY_URL=http://egress:8080
SCRAPER_BROWSER_RESOURCE_LIMIT=100
SCRAPER_BROWSER_TOTAL_BYTES=20000000
SCRAPER_BROWSER_READY_TIMEOUT_S=3
# Bind of the standalone internal proxy (Compose overrides it).
SCRAPER_EGRESS_BIND=127.0.0.1

# Model tools: explicit provider/model configuration is recommended.
SCRAPER_EXTRACT_PROVIDER=ollama
SCRAPER_EXTRACT_MODEL=llama3.1
SCRAPER_RESEARCH_PROVIDER=ollama
SCRAPER_RESEARCH_MODEL=llama3.1
SCRAPER_OLLAMA_HOST=http://127.0.0.1:11434
SCRAPER_OLLAMA_NUM_CTX=32768
# false reserves generation for answers; empty uses the model default.
SCRAPER_OLLAMA_THINK=false
SCRAPER_LLM_INPUT_BYTES=16000
SCRAPER_LLM_OUTPUT_TOKENS=2048
ANTHROPIC_API_KEY=

# Search priority: Tavily, Brave, SearXNG, else DuckDuckGo.
TAVILY_API_KEY=
BRAVE_API_KEY=
SCRAPER_SEARXNG_URL=
